# ============================================================
# .env.migrations - VARIABILI PER SCRIPT MIGRAZIONI E COPIA DB
# ⚠️ QUESTO FILE È L'UNICO SORGENTE PER LA CONNESSIONE AI DB.
# 🚫 NON MODIFICARE MAI LA RIGA MIGRATION_TARGET_DB_NAME = "duxiter-2"
# 🚫 QUALSIASI ALTRO VALORE FA FALLIRE TUTTI I RUNNER CON EXIT 1.
# ============================================================

# ----------- [SAFETY LOCK - NON TOCCARE MAI] ---------------
# Whitelist DB ammessi come TARGET. Se target DB non è in lista = EXIT 1.
# Valori possibili: SOLO "duxiter-2" per MVP F0-F3.
MIGRATION_WHITELIST_TARGET_DB=duxiter-2,duxiter2-local,duxiter2-dev
# DB sorgente da copiare SOLO READ. Se sorgente non è "duxiter" = EXIT 1.
MIGRATION_WHITELIST_SOURCE_DB=duxiter
# -----------------------------------------------------------

# ----------- [Connessione Replicaset PRODUZIONE - SOURCE read-only] -----------
MONGODB_URI_SRC_BASE=mongodb://172.19.40.102:27017,172.19.40.103:27017
# SOURCE opts: readPreference=secondaryPreferred, no scritture permesse per policy
MONGODB_URI_SRC_OPTS=replicaSet=rs0&readPreference=secondaryPreferred&maxStalenessSeconds=120&serverSelectionTimeoutMS=10000

# ----------- [Connessione Replicaset STAGING - TARGET (WRITE)] ----------------
# TARGET opts: readPreference=primaryPreferred, w=1 majority local, journal true.
MONGODB_URI_TGT_OPTS=replicaSet=rs0&readPreference=primaryPreferred&w=1&journal=true&serverSelectionTimeoutMS=10000

# DB SOURCE = duxiter (SOLO LETTURA)
MIGRATION_SRC_DB_NAME=duxiter
# DB TARGET = duxiter-2 (SCRITTURA)
MIGRATION_TGT_DB_NAME=duxiter-2

# ----------- [Comportamento script copia DB] ----------------
# Numero documenti per batch in insert_many()
COPY_BATCH_SIZE=5000
# Se true = stampa conteggi per collezione + checksum conteggi finale
COPY_VERBOSE=true
# Se true = salta collezioni che iniziano con "system."
COPY_SKIP_SYSTEM_COLLECTIONS=true
